{
  "name": "@mcp-workers/remote-control-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Loopback agent for bounded native file operations and durable operation receipts.",
  "exports": {
    ".": "./src/server.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "pair:v2": "node --experimental-strip-types src/pair-device.ts",
    "pair:v2:confirm": "node --experimental-strip-types src/confirm-device.ts",
    "install:v2": "node --experimental-strip-types scripts/install-v2.mjs",
    "build:shell": "node scripts/build-session-supervisor.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node scripts/build-session-supervisor.mjs && node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
